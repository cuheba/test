outline_modulate = Color(0.06, 0.04, 0.12, 1)
text = "Зажми ЛКМ и жди: чем дольше держишь, тем сильнее лазер.
Бирюзовые кристаллы слабее, розовые требуют полного заряда.
Зажги оба кристалла, чтобы открыть дверь."
font_size = 48

[node name="Hint2" type="Label3D" parent="Level/Hints" unique_id=1753925850]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4, -26)
pixel_size = 0.006
billboard = 1
modulate = Color(1, 0.9, 0.7, 1)
outline_modulate = Color(0.06, 0.04, 0.12, 1)
text = "Гигант идёт к тебе, только пока ты на него смотришь.
Заставь его пройти по плите: встань так, чтобы плита
оказалась между вами."
font_size = 48

[node name="Hint3" type="Label3D" parent="Level/Hints" unique_id=790350931]
